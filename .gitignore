# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
!.env.example
/supabase/.temp/
**/.wrangler/
**/.dev.vars*

# generated by scripts/prepare-builder-runtime.mjs
/public/builder-runtime/
/.claude/worktrees/

# local operator scratch (SQL receipts, fixtures, zips) — never commit
/work/

# Local agent execution logs and evidence (contain machine paths and account emails)
/docs/execution/

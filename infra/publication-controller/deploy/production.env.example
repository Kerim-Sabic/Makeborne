# Operator-only template. Replace placeholders privately; never commit the real file.
NODE_ENV=production
MBPUB_CONFIG_FILE=/run/config/controller.json
MBPUB_CONTROLLER_IMAGE=<reviewed-controller-image@sha256:digest>
MBPUB_DB_PASSWORD=<dedicated-production-login-password>
MBPUB_VERCEL_TOKEN=<separate-production-controller-token>
MBPUB_BROKER_SECRET=<independent-64-lowercase-hex-HMAC-key>
MBPUB_R2_ACCESS_KEY_ID=<production-bucket-only-access-key-id>
MBPUB_R2_SECRET_ACCESS_KEY=<production-bucket-only-secret-access-key>
# Deliberately no staging bypass, app service key, PG*, SUPABASE*, AWS*, VERCEL* or proxy environment.

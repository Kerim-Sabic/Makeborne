# Optional identity configuration; no secrets in public variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Cloud remains disabled until database migrations and permissions are verified.
MAKEBORNE_CLOUD_ENABLED=false
MAKEBORNE_CLOUD_MIGRATIONS_VERIFIED=false
# Optional local Chromium executable for development PDF exports.
CHROMIUM_EXECUTABLE_PATH=
# No paid generation activation switch is provided.
# Operator-only durable submission qualification; does not activate a worker,
# provider dispatch, public creation or any spending cap.
MAKEBORNE_DURABLE_SUBMISSIONS_ENABLED=false
# Server-owned validated website routing policy JSON; no credentials. Empty
# disables preparation. This does not enable any worker or public generation.
MAKEBORNE_WEBSITE_PREPARATION_POLICY=
# Trusted saved-copy slide composition policy; no default executable routes.
# Preparation does not enable presentation submission, workers or paid dispatch.
MAKEBORNE_PRESENTATION_PREPARATION_POLICY=
# Additional operator-only composition submission gate. Does not provision a
# runtime/provider or enable public generation; all spending caps remain separate.
MAKEBORNE_PRESENTATION_SUBMISSIONS_ENABLED=false

# Private compiled previews: server-only and closed by default. These values do
# not provision a gateway, private store or wildcard DNS/TLS. Deploy and verify
# those separately before enabling. Never serve generated code on the app host.
MAKEBORNE_PRIVATE_PREVIEWS_ENABLED=false
MAKEBORNE_PREVIEW_APPLICATION_ORIGIN=
MAKEBORNE_PREVIEW_BASE_ORIGIN=
# Explicit localhost qualification only; keep false in production.
MAKEBORNE_PREVIEW_ALLOW_LOCALHOST=false

# Server-only Whop creation membership integration. Never use NEXT_PUBLIC_ for secrets.
# Coffee support checkout uses its verified public Whop URL and grants no app access.
WHOP_API_KEY=
WHOP_COMPANY_ID=biz_CV9cZg1zFX3h7f
WHOP_ACCESS_PLAN_IDS=plan_qs8XNbKQsowC6,plan_arwSDewCa8Dvi,plan_Wf2CTdqqUwufk
WHOP_WEBHOOK_SECRET=
SUPABASE_SECRET_KEY=
WHOP_CREATION_ENABLED=false
MAKEBORNE_BILLING_MIGRATIONS_VERIFIED=false
# Optional Whop plan -> credit tier map for monthly plan credit grants, as
# comma-separated plan_id:tier pairs (tiers: create, studio, scale). The verified
# catalog plans above are always mapped; use this for extra (e.g. yearly) plans.
# Example: WHOP_PLAN_CREDIT_MAP=plan_xxx:create,plan_yyy:studio
WHOP_PLAN_CREDIT_MAP=

# Separate GitHub App for website repository exports (not the Supabase sign-in app).
# Expiring user tokens and Contents write / Metadata read permissions only.
MAKEBORNE_GITHUB_CLIENT_ID=
MAKEBORNE_GITHUB_CLIENT_SECRET=
MAKEBORNE_GITHUB_APP_SLUG=makeborne-websites
# Independent random 32-byte key encoded as 64 hexadecimal characters.
MAKEBORNE_GITHUB_ENCRYPTION_KEY=

# Live builder (streaming website agent at /api/build). Enabled when an Anthropic
# key is present; set MAKEBORNE_LIVE_BUILDER_ENABLED=false to switch it off.
ANTHROPIC_API_KEY=
MAKEBORNE_LIVE_BUILDER_ENABLED=true
# Optional model override (defaults to claude-opus-5-5).
MAKEBORNE_BUILDER_MODEL=
# Provider cost (USD) represented by one credit. Plan allowances and the trial
# (billing_settings.trial_credits, default 150) are priced against this value.
MAKEBORNE_USD_PER_CREDIT=0.01
# Original image generation for websites (optional). Without it the builder
# designs with typography, CSS and inline SVG.
OPENAI_API_KEY=
MAKEBORNE_IMAGE_MODEL=gpt-image-1

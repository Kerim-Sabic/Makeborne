# Optional identity configuration; no secrets in public variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Cloud remains disabled until database migrations and permissions are verified.
MAKEBORNE_CLOUD_ENABLED=false
MAKEBORNE_CLOUD_MIGRATIONS_VERIFIED=false
# Optional local Chromium executable for development PDF exports.
CHROMIUM_EXECUTABLE_PATH=
# No paid generation activation switch is provided.
# Operator-only durable submission qualification; does not activate a worker,
# provider dispatch, public creation or any spending cap.
MAKEBORNE_DURABLE_SUBMISSIONS_ENABLED=false
# Server-owned validated website routing policy JSON; no credentials. Empty
# disables preparation. This does not enable any worker or public generation.
MAKEBORNE_WEBSITE_PREPARATION_POLICY=
# Trusted saved-copy slide composition policy; no default executable routes.
# Preparation does not enable presentation submission, workers or paid dispatch.
MAKEBORNE_PRESENTATION_PREPARATION_POLICY=
# Additional operator-only composition submission gate. Does not provision a
# runtime/provider or enable public generation; all spending caps remain separate.
MAKEBORNE_PRESENTATION_SUBMISSIONS_ENABLED=false

# Private compiled previews: server-only and closed by default. These values do
# not provision a gateway, private store or wildcard DNS/TLS. Deploy and verify
# those separately before enabling. Never serve generated code on the app host.
MAKEBORNE_PRIVATE_PREVIEWS_ENABLED=false
MAKEBORNE_PREVIEW_APPLICATION_ORIGIN=
MAKEBORNE_PREVIEW_BASE_ORIGIN=
# Explicit localhost qualification only; keep false in production.
MAKEBORNE_PREVIEW_ALLOW_LOCALHOST=false

# Server-only Whop creation membership integration. Never use NEXT_PUBLIC_ for secrets.
# Coffee support checkout uses its verified public Whop URL and grants no app access.
WHOP_API_KEY=
WHOP_COMPANY_ID=biz_CV9cZg1zFX3h7f
WHOP_ACCESS_PLAN_IDS=plan_qs8XNbKQsowC6,plan_arwSDewCa8Dvi,plan_Wf2CTdqqUwufk
WHOP_WEBHOOK_SECRET=
SUPABASE_SECRET_KEY=
WHOP_CREATION_ENABLED=false
MAKEBORNE_BILLING_MIGRATIONS_VERIFIED=false
# Credit packs remain closed until exact migration + sandbox delivery/recovery qualification.
WHOP_TOPUPS_ENABLED=false
MAKEBORNE_TOPUP_MIGRATIONS_VERIFIED=false
MAKEBORNE_TOPUP_CHECKOUT_QUALIFIED=false
# Test-only bypass of qualification; works only with isolated local Whop sandbox config.
MAKEBORNE_TOPUP_SANDBOX_TEST=false
# Protected reconciliation stays active independently of new sales once qualified.
MAKEBORNE_TOPUP_RECONCILE_ENABLED=false
# Optional Whop plan -> credit tier map for monthly plan credit grants, as
# comma-separated plan_id:tier[:interval] entries (tiers: create, studio, scale;
# interval monthly or yearly, default monthly). The verified catalog plans above
# are monthly; entries here add plans or override a catalog plan. A yearly plan
# releases its tier's monthly credits once per month (12 per year).
# A plan grants access only if it is listed in WHOP_ACCESS_PLAN_IDS, resolves
# here or in the catalog, AND is enabled in makeborne_private.billing_access_plans;
# anything else (unknown, malformed, the support plan) is ignored and reported.
# Example: WHOP_PLAN_CREDIT_MAP=plan_xxx:create:yearly,plan_yyy:studio
WHOP_PLAN_CREDIT_MAP=
# Whop API base: production by default; https://sandbox-api.whop.com/api/v1 for
# Whop's sandbox (test cards, no real money). Any other value is ignored.
WHOP_API_BASE_URL=
# Plan credit reconciliation job (/api/cron/billing-reconcile). OFF until the
# release review approves scheduling. CRON_SECRET (32+ random characters) is the
# bearer token Vercel Cron sends; see docs/BILLING_PLAN_CREDITS.md.
MAKEBORNE_BILLING_RECONCILE_ENABLED=false
CRON_SECRET=

# Separate GitHub App for website repository exports (not the Supabase sign-in app).
# Expiring user tokens and Contents write / Metadata read permissions only.
MAKEBORNE_GITHUB_CLIENT_ID=
MAKEBORNE_GITHUB_CLIENT_SECRET=
MAKEBORNE_GITHUB_APP_SLUG=makeborne-websites
# Independent random 32-byte key encoded as 64 hexadecimal characters.
MAKEBORNE_GITHUB_ENCRYPTION_KEY=

# Live builder (streaming website agent at /api/build). Enabled when an Anthropic
# key is present; set MAKEBORNE_LIVE_BUILDER_ENABLED=false to switch it off.
ANTHROPIC_API_KEY=
MAKEBORNE_LIVE_BUILDER_ENABLED=true
# Optional model override (defaults to claude-opus-5-5).
MAKEBORNE_BUILDER_MODEL=
# Optional explicit fallback models (comma-separated), tried after the primary's
# retries from the same run budget. Every model must have a verified price in
# src/lib/ai/prices.ts, or the run fails closed. Off by default.
MAKEBORNE_BUILDER_FALLBACK_MODELS=
# Live AI calls also need daily provider limits set in the database by its owner
# (makeborne_private.set_live_provider_limit); they ship disabled. See docs/AI_SPENDING.md.
# Internal AI provider cost (USD) represented by one credit; usage converts to
# credits at this rate. Not the customer price per credit. Must stay at or below
# the margin ceiling enforced in src/lib/billing/margins.ts (higher values are
# ignored). The legacy name MAKEBORNE_USD_PER_CREDIT is still read if this is unset.
MAKEBORNE_AI_COST_USD_PER_CREDIT=0.03
# Free tier: OFF for the approved launch scope. Do not enable implicitly on deploy.
# Original image generation (optional, off by default). Images run only when
# BOTH are set and the model has a current price card in src/lib/ai/prices.ts.
# There is no default model. Otherwise the builder designs with typography, CSS
# and inline SVG. gpt-image-1 is refused from 2026-10-23; gpt-image-2 is priced
# but needs one approved live qualification before use (docs/AI_SPENDING.md).
OPENAI_API_KEY=
MAKEBORNE_IMAGE_MODEL=

# Published website addresses. Unset: existing https://sites.makeborne.com/<slug>,
# static only. The isolated domain (and customer JavaScript) needs all three, set
# only after the prerequisites in docs/HOSTING_DOMAIN.md are verified.
NEXT_PUBLIC_MAKEBORNE_SITE_HOSTING=
NEXT_PUBLIC_MAKEBORNE_SITE_URL_TEMPLATE=
NEXT_PUBLIC_MAKEBORNE_SITE_DOMAIN_VERIFIED=

# Trusted full-source publication is OFF until migration 54, the matching app and
# customer host, and a separately isolated durable compiler/renderer worker are
# qualified together. This flag does NOT provision a worker. The local Docker
# adapter is operator-only. See docs/TRUSTED_PUBLICATION.md.
MAKEBORNE_TRUSTED_PUBLICATION_ENABLED=false

# Server-only address allocation guard; migration 56 independently enforces it.
# Staging requires the separate staging DB plus its owner-configured QA workspace.
# See docs/STAGING_HOSTING_ISOLATION.md. Never opt production into staging mode.
MAKEBORNE_HOSTING_NAMESPACE=production
MAKEBORNE_STAGING_QA_WORKSPACE_ID=

# Staging-only private publication source broker. Remains OFF until the pinned
# app alias, protection bypass and full 20 MB response streaming are qualified.
# No production transport support. Share a dedicated random 32-byte / 64 lowercase
# hex secret only with the restricted controller; never expose Storage keys to it.
# Origin is a verified staging-project/team alias or deployment, with no path.
MAKEBORNE_PUBLICATION_ASSET_BROKER_ENABLED=false
MAKEBORNE_PUBLICATION_ASSET_BROKER_ORIGIN=
MAKEBORNE_PUBLICATION_ASSET_BROKER_SECRET=

# Candidate/recovery build only. "on" stops API work before authentication;
# signed billing notifications still reach signature verification/reconciliation.
# Does not pause previous deployments or in-flight jobs; use the release runbook.
MAKEBORNE_RELEASE_MAINTENANCE=off

# Shared only between customer-site Worker and app server; never NEXT_PUBLIC.
# Worker binding: FORMS_SIGNING_SECRET. Missing secret keeps forms closed.
MAKEBORNE_FORMS_SIGNING_SECRET=

# Set false in isolated staging to disable the live support checkout.
MAKEBORNE_SUPPORT_CHECKOUT_ENABLED=true

# Explicit artwork-upload opt-in; off on hosted apps until storage is qualified.
NEXT_PUBLIC_MAKEBORNE_ARTWORK_UPLOADS_ENABLED=false

# CRM email automation (docs/EMAIL_AUTOMATION.md). Secrets: set in the host environment only.
MAKEBORNE_MAIL_ENCRYPTION_KEY=
MAKEBORNE_GOOGLE_MAIL_CLIENT_ID=
MAKEBORNE_GOOGLE_MAIL_CLIENT_SECRET=
MAKEBORNE_MICROSOFT_MAIL_CLIENT_ID=
MAKEBORNE_MICROSOFT_MAIL_CLIENT_SECRET=
MAKEBORNE_MAIL_AUTOMATION_ENABLED=false
# Expert chat (Haiku standard, Opus Genius). Set false to hide.
MAKEBORNE_EXPERT_CHAT_ENABLED=true

# Search ownership codes: the content value only (docs/OWNER_SETUP_CHECKLIST.md, section 4).
MAKEBORNE_GOOGLE_SITE_VERIFICATION=
MAKEBORNE_BING_SITE_VERIFICATION=
